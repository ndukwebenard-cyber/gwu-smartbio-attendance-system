%% ============================================================================
%% GLOBAL WEALTH UNIVERSITY — SMARTBIO ATTENDANCE SYSTEM
%% Role-Based Access Control (RBAC), Institutional Gatekeeping & Route Guards
%% Demonstrates Principle of Least Privilege (PoLP) & Separation of Duties (SoD)
%% Open in https://mermaid.live
%% ============================================================================

    Entry([User Opens SmartBio Platform]) --> AuthGate{Firebase Auth\nSign-In Screen}

    %% Registration Path — Gatekeeping
    AuthGate -- "New User? Register" --> RegForm[/"📝 Registration Form\n(Role + Passcode Required)"/]
    RegForm --> IsStudent{Role Selected?}
    IsStudent -- "🎓 Student\n(Open Enrollment)" --> StudentReg[Create Account\nNo Passcode Needed]
    IsStudent -- "👥 Class Rep\n🔐 GWU-PROCTOR-2026" --> PasscodeCheck1{Passcode\nValid?}
    IsStudent -- "👨‍🏫 Lecturer\n🔐 GWU-FACULTY-2026" --> PasscodeCheck2{Passcode\nValid?}
    IsStudent -- "👨‍💼 Admin\n🔐 GWU-ADMIN-2026" --> PasscodeCheck3{Passcode\nValid?}

    PasscodeCheck1 -- "❌ Wrong Key" --> Denied1["⛔ Access Denied\n(Privilege Escalation Blocked)"]
    PasscodeCheck2 -- "❌ Wrong Key" --> Denied2["⛔ Access Denied\n(Privilege Escalation Blocked)"]
    PasscodeCheck3 -- "❌ Wrong Key" --> Denied3["⛔ Access Denied\n(Privilege Escalation Blocked)"]

    PasscodeCheck1 -- "✅ Correct" --> RepReg[Create CLASS_REP Account\nFirebase Auth + Firestore]
    PasscodeCheck2 -- "✅ Correct" --> LecturerReg[Create LECTURER Account\nFirebase Auth + Firestore]
    PasscodeCheck3 -- "✅ Correct" --> AdminReg[Create ADMIN Account\nFirebase Auth + Firestore]

    StudentReg & RepReg & LecturerReg & AdminReg --> SignIn

    %% Authentication Path
    AuthGate -- "Existing User" --> SignIn[/🔐 signInWithEmailAndPassword\nFirebase Auth JWT Token/]
    SignIn --> RoleCheck{RBAC Role Resolver\nDecodes JWT Claims}

    %% Navbar Route Guard Lockdown
    RoleCheck -- "Role: STUDENT" --> StudentGuard["🔒 Route Guard Active\nTabs: Student Portal ONLY\nHidden: Admin · Lecturer · Class Rep · Scanner"]
    StudentGuard --> StudentView["🎓 Student Portal\n• NUC 75% Progress Gauges\n• Lecture Attendance Log\n• QR Exam Clearance Docket"]

    RoleCheck -- "Role: CLASS_REP" --> RepGuard["🔒 Route Guard Active\nTabs: Class Rep · Student · Kiosk"]
    RepGuard --> RepView["👥 Class Rep Portal"]
    RepView --> RepPermsAllowed["✅ ALLOWED:\n• Launch Kiosk Scanner Mode\n• View Live Headcount Radar\n• Broadcast 75% Defaulter Warning\n• View Own Exam Clearance Docket"]
    RepView --> RepPermsDenied["❌ PROHIBITED (SoD Boundary):\n• CANNOT Override Flagged Scans\n• CANNOT Mark Students Present\n• CANNOT Modify Database Records"]

    RoleCheck -- "Role: LECTURER" --> LecturerGuard["🔒 Route Guard Active\nTabs: Lecturer Portal · Kiosk"]
    LecturerGuard --> LecturerView["👨‍🏫 Lecturer Portal\n• Start/End Live Sessions\n• Stream Real-Time Attendance Radar\n• Review & Override Flagged Exceptions\n• Export NUC Defaulter Lists"]

    RoleCheck -- "Role: ADMIN" --> AdminGuard["🔓 Full Access (All Portals)\nAdmin · Lecturer · Class Rep · Student · Kiosk"]
    AdminGuard --> AdminView["👨‍💼 Administrator Portal\n• Manage Users & Courses\n• View NDPA Audit Trail\n• ☁️ 1-Click Firestore Cloud Seeder\n• SQL Dump Exporter\n• System Reset to Seeds"]

    %% Switch User / Sign Out
    StudentGuard & RepGuard & LecturerGuard & AdminGuard --> SwitchUser["🚪 Switch User Button\n(Clears JWT Session\n→ Returns to Sign-In Screen)"]

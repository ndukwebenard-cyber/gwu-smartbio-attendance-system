rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : 'STUDENT';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'ADMIN');
    }

    // 2. Active & Historical Lecture Sessions
    match /lecture_sessions/{sessionId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && (getUserRole() == 'LECTURER' || getUserRole() == 'ADMIN');
      allow delete: if isAuthenticated() && getUserRole() == 'ADMIN';
    }

    // 3. Attendance Records
    match /attendance_records/{recordId} {
      allow read: if true;
      allow create: if true; // Allows Scanner Kiosks and WebAuthn hardware check-ins
      allow update, delete: if isAuthenticated() && (getUserRole() == 'LECTURER' || getUserRole() == 'ADMIN');
    }

    // 4. Flagged Exceptions Queue
    match /flagged_exceptions/{flagId} {
      allow read: if true;
      allow create: if true; // Scanner Kiosks route flagged scans
      // Only Lecturers and Admins can resolve or approve flagged exceptions (NDPA 2023 Rule)
      allow update, delete: if isAuthenticated() && (getUserRole() == 'LECTURER' || getUserRole() == 'ADMIN');
    }

    // 5. Courses and Registrations
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAuthenticated() && getUserRole() == 'ADMIN';
    }

    // 6. Immutable NDPA Audit Trail Logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (getUserRole() == 'ADMIN' || getUserRole() == 'LECTURER');
      allow create: if true;
      allow update, delete: if false; // Immutable logs
    }
  }
}
